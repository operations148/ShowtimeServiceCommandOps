# ServiceOps Command Center — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# App
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=

# GoHighLevel Integration
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_LOCATION_ID=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Get from GHL → Settings → Private Integrations
# Format: pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_WEBHOOK_SECRET=
# REQUIRED. Maps an inbound GHL locationId to a ServiceOps tenant UUID.
# Inbound webhooks resolve tenant SOLELY from this map (src/lib/ghl/tenant-config.ts).
# If it is missing, malformed, empty, or does not contain GHL_LOCATION_ID, every
# inbound delivery is discarded as unknown_tenant and NO work order is created —
# while everything else still looks correctly configured.
# Validated structurally at build time by scripts/validate-env.sh.
# Format: {"<ghlLocationId>":"<tenantUuid>"}
GHL_LOCATION_TO_TENANT={"YOUR_GHL_LOCATION_ID":"00000000-0000-0000-0000-000000000000"}
# Maps a GHL user ID to a ServiceOps technician ID. Optional.
# Unmapped users simply leave the work order unassigned.
GHL_USER_TO_TECHNICIAN={}
# ⚠️  DEAD CONFIG — has NO effect on inbound webhook routing.
# Read only by isJobReadyStage() in map-opportunity.ts, which is reachable only
# from create-work-order-from-ghl.ts — a module with zero importers. The live
# route matches exact stage names from src/lib/constants/ghl-pipeline.ts instead.
# Kept for now to avoid churn; changing this value changes nothing.
GHL_JOB_READY_STAGES=Diagnosis Booked,Estimate Approved,In Progress

# Database
DATABASE_URL=

# Supabase — find these at https://supabase.com/dashboard/project/_/settings/api
# NEXT_PUBLIC_ vars are safe to expose to the browser (subject to RLS).
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — keep server-side only, never expose to browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# (Legacy var name — kept for compatibility; prefer NEXT_PUBLIC_SUPABASE_URL above)
SUPABASE_URL=

# Auth (NextAuth.js)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Must match your dev/prod URL exactly
NEXTAUTH_URL=http://localhost:3000

# File Storage
STORAGE_BUCKET=
AVATAR_BUCKET=avatars

# App Environment
APP_ENV=development

# GHL Location ID — safe to expose to browser (used in Settings panel display only)
NEXT_PUBLIC_GHL_LOCATION_ID=

# Reporting mode — set to 'mock' when GHL token is absent or in dev
# Remove or set to 'live' once GHL integration is active
NEXT_PUBLIC_REPORTING_MODE=mock

# Resend Email Service
# Get from https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified domain in Resend (e.g. noreply@yourdomain.com)
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Public app URL used in email links
NEXT_PUBLIC_APP_URL=https://serviceops-ghl-workorders-chi.vercel.app
